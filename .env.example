# ==============================================================================
# Marketing Machine: Environment Variables Template
# Copy this file to .env.local and populate with your credentials.
# ==============================================================================

# --- Supabase Database & Realtime ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Meta WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=your-whatsapp-bearer-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-account-id
META_APP_SECRET=your_meta_app_secret_for_hmac_sha256
WHATSAPP_WEBHOOK_VERIFY_TOKEN=my_secure_verify_token_123
WHATSAPP_FOLLOWUP_TEMPLATE_NAME=lead_reengagement

# --- AI Intelligence Provider (Azure OpenAI or Direct OpenAI) ---
# Option A: Azure OpenAI (Enterprise)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-nano
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Option B: Direct OpenAI Fallback
OPENAI_API_KEY=sk-proj-your_openai_api_key
OPENAI_MODEL_NAME=gpt-4o-mini

# --- Real-Time Push Alerts (Telegram) ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-1001234567890

# --- Transactional Email Alerts (Resend) ---
RESEND_API_KEY=re_123456789...
NOTIFICATION_EMAIL=owner@studio.com

# --- Pipeline Configuration & Cron Security ---
AI_QUALIFIED_THRESHOLD=70
CRON_SECRET=your-random-cron-secret
